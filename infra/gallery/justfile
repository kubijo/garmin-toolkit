import '../just/common.just'

export CARGO_TARGET_DIR := repository_root / "target/gallery"

# Run the native gallery from the current development environment.
run:
    {{ quote(memory_capped) }} env CARGO_INCREMENTAL=0 \
        cargo run --manifest-path Cargo.toml

# Run the native gallery with scene hot reload.
hot:
    {{ quote(memory_capped) }} env CARGO_INCREMENTAL=0 \
        cargo run --manifest-path Cargo.toml -- --hot

# Type-check the gallery and every discovered scene.
check:
    {{ quote(memory_capped) }} env CARGO_INCREMENTAL=0 \
        cargo check --manifest-path Cargo.toml --all-features

# Lint the gallery host, adapter, and every discovered scene.
lint:
    {{ quote(memory_capped) }} env CARGO_INCREMENTAL=0 \
        cargo clippy --manifest-path Cargo.toml --all-targets --all-features -- --deny warnings

# Link the gallery host and reloadable scene library.
build:
    {{ quote(memory_capped) }} env CARGO_INCREMENTAL=0 \
        cargo build --manifest-path Cargo.toml --all-features

# Render one scene without opening a window.
render SCENE OUT SIZE='1280x720':
    {{ quote(memory_capped) }} env CARGO_INCREMENTAL=0 WGPU_BACKEND=vulkan \
        cargo run --quiet \
        --manifest-path Cargo.toml --all-features -- \
        --scene "{{ SCENE }}" --render "{{ OUT }}" --size {{ SIZE }}

# Render one maintained capture set without opening a window.
capture FILE='components.capture.toml' OUT='':
    {{ quote(memory_capped) }} env CARGO_INCREMENTAL=0 WGPU_BACKEND=vulkan \
        cargo run --quiet \
        --manifest-path Cargo.toml --all-features -- \
        --capture "{{ FILE }}" {{ if OUT == '' { '' } else { '--out "' + OUT + '"' } }}

# Render every maintained evidence sheet.
capture-all:
    just capture components.capture.toml
    just capture activity-map.capture.toml
    just capture renderer-diagnostics.capture.toml
    just capture device-explorer.capture.toml
    just capture visual-language.capture.toml
    just capture desktop.capture.toml
    just capture web.capture.toml
    just capture tui.capture.toml

# Reproduce one maintained capture set inside the pinned Nix environment.
capture-nix FILE='components.capture.toml' OUT='':
    {{ quote(memory_capped) }} env CARGO_INCREMENTAL=0 WGPU_BACKEND=vulkan \
        nix develop --command cargo run --quiet \
        --manifest-path Cargo.toml --all-features -- \
        --capture "{{ FILE }}" {{ if OUT == '' { '' } else { '--out "' + OUT + '"' } }}

# Build the isolated gallery and its lints through Nix.
ci:
    {{ quote(memory_capped) }} env CARGO_INCREMENTAL=0 \
        nix build -L {{ flake }}#checks.{{ arch() }}-linux.gallery

# List a scene's configurable capture values.
knobs SCENE:
    {{ quote(memory_capped) }} env CARGO_INCREMENTAL=0 \
        cargo run --quiet --manifest-path Cargo.toml --all-features -- \
        --scene "{{ SCENE }}" --list-knobs
