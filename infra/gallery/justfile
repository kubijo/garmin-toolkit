import '../just/common.just'

export CARGO_TARGET_DIR := repository_root / ".tmp/gallery-target"
gallery_backend := env('WGPU_BACKEND', if os() == 'macos' { 'metal' } else { 'vulkan' })

# Run the gallery; --hot enables scene reload.
run *args: require-linker
    @{{ quote(memory_capped) }} cargo run --manifest-path Cargo.toml -- "$@"

# Run the gallery with scene hot reload.
hot: (run "--hot")

# Type-check the gallery and every discovered scene.
check: require-linker
    {{ quote(memory_capped) }} \
        cargo check --manifest-path Cargo.toml --all-features

# Lint the gallery host, adapter, and every discovered scene.
lint: require-linker
    {{ quote(memory_capped) }} \
        cargo clippy --manifest-path Cargo.toml --all-targets --all-features -- --deny warnings

# Link the gallery host and reloadable scene library.
build: require-linker
    {{ quote(memory_capped) }} \
        cargo build --manifest-path Cargo.toml --all-features

# Render one scene without opening a window.
render SCENE OUT SIZE='1280x720': require-linker
    {{ quote(memory_capped) }} env WGPU_BACKEND={{ quote(gallery_backend) }} \
        cargo run --quiet \
        --manifest-path Cargo.toml --all-features -- \
        --scene "{{ SCENE }}" --render "{{ OUT }}" --size {{ SIZE }}

# Render a capture set; pass --out PATH to override its output directory.
capture FILE='captures/components.capture.toml' *options: require-linker
    @{{ quote(memory_capped) }} env WGPU_BACKEND={{ quote(gallery_backend) }} \
        cargo run --quiet --manifest-path Cargo.toml --all-features -- --capture "$@"

# Render all maintained capture sets.
capture-all:
    #!/usr/bin/env bash
    set -euo pipefail
    for capture in captures/*.capture.toml; do
        just capture "$capture"
    done

# Run gallery tests; pass a filter and -- --ignored for opt-in captures.
test *args: require-linker
    @{{ quote(memory_capped) }} env WGPU_BACKEND={{ quote(gallery_backend) }} cargo test --manifest-path Cargo.toml "$@"

# Build the isolated gallery and its lints through Nix.
ci:
    {{ quote(memory_capped) }} env CARGO_INCREMENTAL=0 \
        nix build -L {{ flake }}#checks.{{ arch() }}-{{ if os() == 'macos' { 'darwin' } else { 'linux' } }}.gallery

# List a scene's configurable capture values.
knobs SCENE: require-linker
    {{ quote(memory_capped) }} \
        cargo run --quiet --manifest-path Cargo.toml --all-features -- \
        --scene "{{ SCENE }}" --list-knobs
