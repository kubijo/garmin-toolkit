import '../../infra/just/common.just'

# Run production data or an isolated, deterministic demo corpus.
run mode:
    #!/usr/bin/env bash
    set -euo pipefail

    case {{ quote(mode) }} in
        production) features=() ;;
        demo) features=(--features demo) ;;
        *) printf 'deployment mode must be production or demo\n' >&2; exit 64 ;;
    esac

    exec just in-shell cargo run --locked -p garmin-desktop "${features[@]}"

# Pre-warm the exact optimized binary used by a profiling capture.
profile-build mode:
    @just in-shell python infra/python/desktop_profile.py build {{ quote(mode) }}

# Record immutable Samply/runtime evidence and derive one enriched profile; close the app to finish.
profile mode REPORT='00-latest' *samply_args:
    @shift 2; exec just in-shell python infra/python/desktop_profile.py record {{ quote(mode) }} {{ quote(REPORT) }} -- "$@"

# Open a named enriched report in the local profiler UI.
profile-load REPORT='00-latest':
    just in-shell samply load {{ quote(repository_root) }}/.tmp/profiles/{{ quote(REPORT) }}/combined.json.gz

# Write the selected AppImage to dist.
appimage mode:
    #!/usr/bin/env bash
    set -euo pipefail

    case {{ quote(mode) }} in
        production) app=desktop-appimage ;;
        demo) app=desktop-demo-appimage ;;
        *) printf 'deployment mode must be production or demo\n' >&2; exit 64 ;;
    esac

    exec just in-shell nix run "{{ flake }}#${app}"

# Build the selected Flatpak bundle into dist.
flatpak mode:
    #!/usr/bin/env bash
    set -euo pipefail

    case {{ quote(mode) }} in
        production) app=desktop-flatpak ;;
        demo) app=desktop-demo-flatpak ;;
        *) printf 'deployment mode must be production or demo\n' >&2; exit 64 ;;
    esac

    exec just in-shell nix run "{{ flake }}#${app}"
